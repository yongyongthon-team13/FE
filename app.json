{
  "expo": {
    "name": "yongyongthon-team13",
    "slug": "yongyongthon-team13",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yongyongthonteam13",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yongyongthonteam13.yongyongthonteam13",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "병원 문자 캡처 사진으로 일정을 만들기 위해 사진 접근이 필요해요."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "어르신의 답변을 음성으로 받기 위해 마이크를 사용해요.",
          "speechRecognitionPermission": "말씀하신 내용을 글자로 바꾸기 위해 음성 인식을 사용해요."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "병원 가는 길을 안내하고 보호자에게 위치를 알려드리기 위해 위치를 사용해요."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7b895117-aa23-40e7-b1e1-8d2daa162a06"
      }
    }
  }
}
